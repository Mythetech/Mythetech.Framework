@using System.Reflection
@using Mythetech.Framework.Components.Settings
@using Mythetech.Framework.Components.Settings.Editors
@using Mythetech.Framework.Infrastructure.Settings
@attribute [Stories("Components/Settings/Setting Row")]

<Stories TComponent="DynamicSettingControl">

    <DefaultStory Name="Beside the Label" TComponent="DynamicSettingControl">
        <Template>
            <div class="setting-row-story pa-4">
                <DynamicSettingControl Settings="@_settings"
                                       Property="@Property(nameof(DemoSettings.Username))"
                                       Attribute="@Attribute(nameof(DemoSettings.Username))" />
            </div>
        </Template>
    </DefaultStory>

    <DefaultStory Name="Stacked" TComponent="DynamicSettingControl">
        <Template>
            <div class="setting-row-story pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                    Set <code>Stacked = true</code> on a setting whose editor is too large to share a row with its label.
                    The editor gets its own full-width row beneath the label and description.
                </MudText>
                <DynamicSettingControl Settings="@_settings"
                                       Property="@Property(nameof(DemoSettings.BuildService))"
                                       Attribute="@Attribute(nameof(DemoSettings.BuildService))" />
            </div>
        </Template>
    </DefaultStory>

    <DefaultStory Name="Every Editor" TComponent="DynamicSettingControl">
        <Template>
            <div class="setting-row-story pa-4 d-flex flex-column gap-2">
                @foreach (var name in EditorRows)
                {
                    <DynamicSettingControl @key="name"
                                           Settings="@_settings"
                                           Property="@Property(name)"
                                           Attribute="@Attribute(name)" />
                }
            </div>
        </Template>
    </DefaultStory>

</Stories>

@code {
    private readonly DemoSettings _settings = new();

    private static readonly string[] EditorRows =
    [
        nameof(DemoSettings.FontFamily),
        nameof(DemoSettings.LineEnding),
        nameof(DemoSettings.Density),
        nameof(DemoSettings.MaxResults),
        nameof(DemoSettings.FontSize),
        nameof(DemoSettings.Scale),
        nameof(DemoSettings.ShowMinimap),
    ];

    private static PropertyInfo Property(string name) => typeof(DemoSettings).GetProperty(name)!;

    private static SettingAttribute Attribute(string name) => Property(name).GetCustomAttribute<SettingAttribute>()!;

    private class DemoSettings : SettingsBase
    {
        public override string SettingsId => "setting-row-demo";
        public override string DisplayName => "Setting Row";
        public override string Icon => MythetechFrameworkIcons.Settings;

        [Setting(Label = "Username", Description = "Your display name", CustomEditor = typeof(StringSettingEditor))]
        public string Username { get; set; } = "User";

        [Setting(
            Label = "Status",
            Description = "Builds run on the build service, signed in with your account",
            CustomEditor = typeof(SettingRowStatusEditor),
            Stacked = true)]
        public string BuildService { get; set; } = "";

        [Setting(Label = "Font Family", Description = "The font to use in the editor", CustomEditor = typeof(StringSettingEditor))]
        public string FontFamily { get; set; } = "JetBrains Mono, Consolas, 'Courier New'";

        [Setting(Label = "Line Endings", Description = "Used for new files", Options = "LF,CRLF", CustomEditor = typeof(StringSettingEditor))]
        public string LineEnding { get; set; } = "LF";

        [Setting(Label = "Density", Description = "Spacing between rows", CustomEditor = typeof(EnumSettingEditor))]
        public RowDensity Density { get; set; } = RowDensity.Comfortable;

        [Setting(Label = "Max Results", Description = "Search stops after this many matches", CustomEditor = typeof(IntSettingEditor))]
        public int MaxResults { get; set; } = 500;

        [Setting(Label = "Font Size", Min = 8, Max = 32, CustomEditor = typeof(IntSettingEditor))]
        public int FontSize { get; set; } = 14;

        [Setting(Label = "Scale", Description = "Interface zoom", CustomEditor = typeof(DoubleSettingEditor))]
        public double Scale { get; set; } = 1.0;

        [Setting(Label = "Show Minimap", Description = "A miniature view of the code on the right", CustomEditor = typeof(BoolSettingEditor))]
        public bool ShowMinimap { get; set; } = true;
    }

    private enum RowDensity { Compact, Comfortable, Spacious }
}
