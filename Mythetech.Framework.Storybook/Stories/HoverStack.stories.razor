@using Mythetech.Framework.Components.HoverStack
@attribute [Stories("Components/HoverStack")]

<Stories TComponent="HoverStack">
    <Story Name="Row Actions" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudStack Class="mud-height-full pa-4" Spacing="4">
                <MudText Typo="Typo.h5">Hover or tab into a row to reveal its actions</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    The list is narrow on purpose: long names truncate to make room for the actions, so no row changes height.
                </MudText>

                <div class="hover-story-list">
                    <MudPaper Class="pa-2" Elevation="1">
                        <MudStack Spacing="0">
                            @foreach (var item in _treeItems)
                            {
                                <HoverStack Row AlignItems="AlignItems.Center" Spacing="2" Class="pa-2 rounded">
                                    <ChildContent>
                                        <MudIcon Icon="@MythetechFrameworkIcons.Folder" Size="Size.Small" />
                                        <MudText Class="text-truncate">@item</MudText>
                                    </ChildContent>
                                    <Actions>
                                        <MudIconButton Icon="@MythetechFrameworkIcons.Edit"
                                                       Size="Size.Small"
                                                       aria-label="@($"Rename {item}")" />
                                        <MudIconButton Icon="@MythetechFrameworkIcons.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       aria-label="@($"Delete {item}")" />
                                    </Actions>
                                </HoverStack>
                            }
                        </MudStack>
                    </MudPaper>
                </div>

                <MudDivider Class="my-4" />

                <MudMarkdown Value="@_markdown" Styling="MythetechMarkdownStyling.Default" />
            </MudStack>
        </Template>
    </Story>

    <Story Name="Click Handler" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudStack Class="mud-height-full pa-4" Spacing="4">
                <MudText Typo="Typo.h5">Click on items to select them</MudText>

                <div class="hover-story-list">
                    <MudPaper Class="pa-2" Elevation="1">
                        <MudStack Spacing="0">
                            @foreach (var item in _clickItems)
                            {
                                <HoverStack Row AlignItems="AlignItems.Center" Spacing="2"
                                            Class="@GetItemClass(item)"
                                            OnClick="@(() => HandleItemClick(item))">
                                    <ChildContent>
                                        <MudIcon Icon="@(item == _selectedItem ? MythetechFrameworkIcons.CheckCircle : MythetechFrameworkIcons.RadioButtonUnchecked)"
                                                 Size="Size.Small"
                                                 Color="@(item == _selectedItem ? Color.Primary : Color.Default)" />
                                        <MudText Class="text-truncate">@item</MudText>
                                    </ChildContent>
                                    <Actions>
                                        <MudIcon Icon="@MythetechFrameworkIcons.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                                    </Actions>
                                </HoverStack>
                            }
                        </MudStack>
                    </MudPaper>
                </div>

                <MudText Typo="Typo.body2">
                    Selected: <strong>@(_selectedItem ?? "None")</strong>
                </MudText>

                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Click count: @_clickCount
                </MudText>
            </MudStack>
        </Template>
    </Story>
</Stories>

@code {
    private List<string> _treeItems =
    [
        "Documents",
        "Downloads",
        "A folder with a name long enough that it has to truncate",
        "Music"
    ];
    private List<string> _clickItems = ["Option A", "Option B", "An option with a much longer label than the rest", "Option D"];
    private string? _selectedItem;
    private int _clickCount;

    private void HandleItemClick(string item)
    {
        _selectedItem = item;
        _clickCount++;
    }

    private string GetItemClass(string item)
    {
        var baseClass = "pa-2 rounded cursor-pointer";
        return item == _selectedItem ? $"{baseClass} mud-primary-text" : baseClass;
    }

    private string _markdown = @"
## Usage

`HoverStack` is a row whose `Actions` appear while it is hovered or holds keyboard focus, and always on touch devices. It is pure CSS, so hovering never re-renders the component.

The actions take their room from the content rather than growing the row, so put `text-truncate` on the main label. For rows you build by hand, the same behavior is available as the `mt-hover-row`, `mt-hover-row-label` and `mt-hover-actions` classes.

### Basic Example

```razor
<HoverStack Row AlignItems=""AlignItems.Center"">
    <ChildContent>
        <MudText Class=""text-truncate"">Item Name</MudText>
    </ChildContent>
    <Actions>
        <MudIconButton Icon=""@MythetechFrameworkIcons.Delete"" aria-label=""Delete"" />
    </Actions>
</HoverStack>
```

Never put a menu activator in `Actions`. The menu opens outside the row, so moving the pointer into it ends the hover, hides the activator, and the menu jumps. Keep overflow menu buttons in `ChildContent`, where they are always visible.

### Parameters

- `ChildContent` - The row's content
- `Actions` - Controls revealed on hover or focus
- `OnClick` - Invoked when the row is clicked
- `Class` / `Style` - Applied to the whole row, actions included

These are passed to the content's `MudStack`:
- `Row` - Display items horizontally
- `Reverse` - Reverse item order
- `Spacing` - Gap between items (0-16)
- `Wrap` - Item wrapping behavior; defaults to `NoWrap` so the row stays one line
- `Justify` - Main axis justification
- `AlignItems` - Cross axis alignment
- `StretchItems` - Which children expand to fill space
";
}
