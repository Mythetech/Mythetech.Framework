@using Mythetech.Framework.Components.AppContextDrawer
@using MudBlazor
@attribute [Stories("Components/AppContextDrawer")]

<Stories TComponent="AppContextDrawer">

    <Story Name="Basic Usage" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudLayout Style="height: 500px; position: relative;">
                <MudDrawer @bind-Open="@_drawerOpen" Variant="DrawerVariant.Mini" Style="overflow: hidden;">
                    <AppContextDrawer @bind-IsOpen="@_drawerOpen"
                                      @bind-ActivePanelId="@_activePanelId"
                                      ShowPluginPanels="false">
                        <IconBarHeader>
                            <MudIconButton Icon="@MythetechFrameworkIcons.Home" Color="Color.Primary" Class="my-2" />
                        </IconBarHeader>

                        <PanelNavContent>
                            <ContextPanelItem Id="files" Icon="@MythetechFrameworkIcons.Round("folder")" Title="Files">
                                <PanelContent>
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.body1">File Explorer</MudText>
                                        <MudTreeView T="string" Hover="true">
                                            <MudTreeViewItem Value="@("src")" Icon="@MythetechFrameworkIcons.Round("folder")">
                                                <MudTreeViewItem Value="@("components")" Icon="@MythetechFrameworkIcons.Round("folder")" />
                                                <MudTreeViewItem Value="@("pages")" Icon="@MythetechFrameworkIcons.Round("folder")" />
                                            </MudTreeViewItem>
                                            <MudTreeViewItem Value="@("tests")" Icon="@MythetechFrameworkIcons.Round("folder")" />
                                        </MudTreeView>
                                    </MudStack>
                                </PanelContent>
                            </ContextPanelItem>

                            <ContextPanelItem Id="search" Icon="@MythetechFrameworkIcons.Search" Title="Search">
                                <PanelContent>
                                    <MudStack Spacing="2">
                                        <MudTextField T="string" Label="Search" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@MythetechFrameworkIcons.Search" />
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Enter a search term to find files</MudText>
                                    </MudStack>
                                </PanelContent>
                            </ContextPanelItem>

                            <ContextPanelItem Id="git" Icon="@Icons.Custom.Brands.GitHub" Title="Source Control" BadgeColor="Color.Warning">
                                <PanelContent>
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.body1">Source Control</MudText>
                                        <MudAlert Severity="Severity.Warning" Dense="true">3 uncommitted changes</MudAlert>
                                        <MudList T="string" Dense="true">
                                            <MudListItem Icon="@MythetechFrameworkIcons.Add" IconColor="Color.Success">new-file.cs</MudListItem>
                                            <MudListItem Icon="@MythetechFrameworkIcons.Round("edit")" IconColor="Color.Warning">modified.cs</MudListItem>
                                            <MudListItem Icon="@MythetechFrameworkIcons.Delete" IconColor="Color.Error">deleted.cs</MudListItem>
                                        </MudList>
                                    </MudStack>
                                </PanelContent>
                            </ContextPanelItem>
                        </PanelNavContent>

                        <PanelFooterContent>
                            <MudIconButton Icon="@MythetechFrameworkIcons.Settings" Color="Color.Default" Class="mb-2" />
                        </PanelFooterContent>
                    </AppContextDrawer>
                </MudDrawer>

                <MudMainContent Style="padding: 16px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h5">Main Content Area</MudText>
                        <MudText Typo="Typo.body1">Click the icons in the side panel to expand different sections. When an item sets a <code>RoutePrefix</code>, double clicking it navigates to that page and collapses the drawer.</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Active Panel: @(_activePanelId ?? "None") | Drawer Open: @_drawerOpen
                        </MudText>
                    </MudStack>
                </MudMainContent>
            </MudLayout>
        </Template>
    </Story>

    <Story Name="With Badges" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudLayout Style="height: 400px; position: relative;">
                <MudDrawer Open="true" Variant="DrawerVariant.Mini" Style="overflow: hidden;">
                    <AppContextDrawer IsOpen="true"
                                      ActivePanelId="notifications"
                                      ShowPluginPanels="false">
                        <PanelNavContent>
                            <ContextPanelItem Id="notifications" Icon="@MythetechFrameworkIcons.Round("notifications")" Title="Notifications" BadgeColor="Color.Error">
                                <PanelContent>
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.body1">Notifications</MudText>
                                        <MudAlert Severity="Severity.Error" Dense="true">5 new alerts</MudAlert>
                                    </MudStack>
                                </PanelContent>
                            </ContextPanelItem>

                            <ContextPanelItem Id="status" Icon="@MythetechFrameworkIcons.Circle" Title="Status" BadgeColor="Color.Success">
                                <PanelContent>
                                    <MudText Typo="Typo.body1">All systems operational</MudText>
                                </PanelContent>
                            </ContextPanelItem>

                            <ContextPanelItem Id="sync" Icon="@MythetechFrameworkIcons.Round("sync")" Title="Sync" BadgeColor="Color.Warning">
                                <PanelContent>
                                    <MudText Typo="Typo.body1">Syncing...</MudText>
                                    <MudProgressLinear Indeterminate="true" Color="Color.Warning" />
                                </PanelContent>
                            </ContextPanelItem>
                        </PanelNavContent>
                    </AppContextDrawer>
                </MudDrawer>

                <MudMainContent Style="padding: 16px;">
                    <MudText>Badge colors indicate status: Success (green), Warning (yellow), Error (red)</MudText>
                </MudMainContent>
            </MudLayout>
        </Template>
    </Story>

    <Story Name="Index And Child Routes" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudLayout Style="height: 400px; position: relative;">
                <MudDrawer Open="true" Variant="DrawerVariant.Mini" Style="overflow: hidden;">
                    <AppContextDrawer IsOpen="false" ShowPluginPanels="false">
                        <PanelNavContent>
                            <ContextPanelItem Id="projects" Icon="@MythetechFrameworkIcons.Round("folder")" Title="Projects"
                                              RoutePrefix="/projects" ExactRouteMatch="true">
                                <PanelContent>
                                    <MudText Typo="Typo.body1">All projects</MudText>
                                </PanelContent>
                            </ContextPanelItem>

                            <ContextPanelItem Id="project-alpha" Icon="@MythetechFrameworkIcons.Round("deployed_code")" Title="Alpha"
                                              RoutePrefix="/projects/alpha">
                                <PanelContent>
                                    <MudText Typo="Typo.body1">Project Alpha</MudText>
                                </PanelContent>
                            </ContextPanelItem>
                        </PanelNavContent>
                    </AppContextDrawer>
                </MudDrawer>

                <MudMainContent Style="padding: 16px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body1">
                            <code>Projects</code> sets <code>ExactRouteMatch</code>, so it lights up on <code>/projects</code>
                            but not on <code>/projects/alpha</code>, where only <code>Alpha</code> lights up. Double clicking
                            <code>Projects</code> from anywhere still navigates to <code>/projects</code>.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            Without it, a <code>RoutePrefix</code> matches every route that starts with it, so both icons
                            would light up on <code>/projects/alpha</code>.
                        </MudText>
                    </MudStack>
                </MudMainContent>
            </MudLayout>
        </Template>
    </Story>

    <Story Name="Compact Full Width Rail" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudLayout Style="height: 400px; position: relative;">
                <MudDrawer @bind-Open="@_compactOpen" Variant="DrawerVariant.Mini" Style="overflow: hidden;">
                    <AppContextDrawer @bind-IsOpen="@_compactOpen"
                                      @bind-ActivePanelId="@_compactPanelId"
                                      ShowPluginPanels="false"
                                      ContentClass=""
                                      ContentSpacing="0"
                                      HeaderClass="pa-2 mb-2"
                                      HeaderSpacing="3"
                                      FullWidthItems="true"
                                      ItemColor="Color.Inherit"
                                      TooltipColor="Color.Default">
                        <PanelNavContent>
                            <ContextPanelItem Id="history" Icon="@MythetechFrameworkIcons.Round("history")" Title="History">
                                <PanelContent>
                                    <MudStack Spacing="2" Class="pa-2">
                                        <MudText Typo="Typo.body1">This panel pads itself.</MudText>
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            The drawer adds no padding around it and no gap under the header.
                                        </MudText>
                                    </MudStack>
                                </PanelContent>
                            </ContextPanelItem>

                            <ContextPanelItem Id="collections" Icon="@MythetechFrameworkIcons.Round("folder")" Title="Collections">
                                <PanelContent>
                                    <MudStack Spacing="2" Class="pa-2">
                                        <MudText Typo="Typo.body1">Collections</MudText>
                                    </MudStack>
                                </PanelContent>
                            </ContextPanelItem>
                        </PanelNavContent>

                        <EmptyContent>
                            <MudText Class="pa-4" Typo="Typo.subtitle1">Pick a panel from the rail</MudText>
                        </EmptyContent>
                    </AppContextDrawer>
                </MudDrawer>

                <MudMainContent Style="padding: 16px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body1">
                            For an app whose panels pad themselves. <code>ContentClass</code> and <code>ContentSpacing</code>
                            remove the drawer's own padding and gap, <code>HeaderClass</code> and <code>HeaderSpacing</code>
                            lay out the header, and <code>FullWidthItems</code> makes each rail item fill the icon bar, so the
                            highlight of the active item spans it.
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            <code>ItemColor</code> and <code>TooltipColor</code> set the color of inactive items and of the
                            tooltips, and <code>EmptyContent</code> replaces the "No Item Selected" message. To see it,
                            close the panel and open the drawer again with the button below.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => _compactOpen = true)">
                            Open the drawer
                        </MudButton>
                    </MudStack>
                </MudMainContent>
            </MudLayout>
        </Template>
    </Story>

</Stories>

@code {
    private bool _drawerOpen = true;
    private string? _activePanelId = "files";
    private bool _compactOpen = true;
    private string? _compactPanelId = "history";
}
