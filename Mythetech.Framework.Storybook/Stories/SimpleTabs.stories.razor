@using Mythetech.Framework.Components.SimpleTabs
@using MudBlazor
@attribute [Stories("Components/SimpleTabs")]

<Stories TComponent="SimpleTabs">

    <ProductStory Name="@("(Primary)")" TComponent="SimpleTabs">
        <Arguments>
            <Arg For="_ => _.Color" Value="Color.Primary"/>
        </Arguments>
        <Template>
            <SimpleTabs @attributes="context.Args">
                <Tab Name="Tab 1">
                    Sample content 1
                </Tab>
                <Tab Name="Tab 2">
                    <MudText>Sample Content 2</MudText>
                </Tab>
            </SimpleTabs>
        </Template>
    </ProductStory>
    <Story Name="With Icons" Layout="typeof(DefaultMudLayout)">
        <Arguments>
            <Arg For="_ => _.Color" Value="Color.Primary"/>
        </Arguments>
        <Template>
            <SimpleTabs>
                <Tab Name="Cookies" Icon="@MythetechFrameworkIcons.Round("cookie")">
                    Cookie!
                </Tab>
                <Tab Name="Info" Icon="@MythetechFrameworkIcons.Info">
                    Info!
                </Tab>
            </SimpleTabs>
        </Template>
    </Story>
    <Story Name="Keep Panels Alive" Layout="typeof(DefaultMudLayout)">
        <Template>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                Type into the field, switch tabs and come back: the text is still there, because the inactive tab is hidden rather than removed.
            </MudText>
            <SimpleTabs KeepPanelsAlive="true">
                <Tab Name="Notes" Icon="@MythetechFrameworkIcons.Info">
                    <MudTextField T="string" Label="Unsaved note" />
                </Tab>
                <Tab Name="Other">
                    <MudText>Switch back to Notes.</MudText>
                </Tab>
            </SimpleTabs>
        </Template>
    </Story>
    <Story Name="Without Gutters" Layout="typeof(DefaultMudLayout)">
        <Template>
            <SimpleTabs Gutters="false" WrapperClass="">
                <Tab Name="Edge">
                    <MudPaper Outlined="true" Class="pa-2">Content runs to the edges of the tab group.</MudPaper>
                </Tab>
                <Tab Name="To Edge">
                    <MudPaper Outlined="true" Class="pa-2">For panels that already pad their content.</MudPaper>
                </Tab>
            </SimpleTabs>
        </Template>
    </Story>
    <Story Name="Many Tabs (Responsive)" Layout="typeof(DefaultMudLayout)">
        <Template>
            <SimpleTabs>
                <Tab Name="Dashboard" Icon="@MythetechFrameworkIcons.Dashboard">
                    <MudText>Dashboard content - your main overview</MudText>
                </Tab>
                <Tab Name="Analytics" Icon="@MythetechFrameworkIcons.Round("analytics")">
                    <MudText>Analytics content - view your metrics</MudText>
                </Tab>
                <Tab Name="Reports" Icon="@MythetechFrameworkIcons.Round("assessment")">
                    <MudText>Reports content - generated reports</MudText>
                </Tab>
                <Tab Name="Settings" Icon="@MythetechFrameworkIcons.Settings">
                    <MudText>Settings content - configure your preferences</MudText>
                </Tab>
                <Tab Name="Users" Icon="@MythetechFrameworkIcons.Round("group")">
                    <MudText>Users content - manage team members</MudText>
                </Tab>
            </SimpleTabs>
        </Template>
    </Story>
    <Story Name="Resizable Container" Layout="typeof(DefaultMudLayout)">
        <Template>
            @{
                var containerWidth = _containerWidthPercent;
            }
            <MudStack Spacing="4">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2">Container Width:</MudText>
                    <MudSlider @bind-Value="_containerWidthPercent" Min="20" Max="100" Step="5" Color="Color.Primary" Style="width: 200px;" />
                    <MudText Typo="Typo.body2">@(_containerWidthPercent)%</MudText>
                </MudStack>
                <div style="width: @(containerWidth)%; border: 1px dashed var(--mud-palette-lines-default); border-radius: 4px; padding: 8px;">
                    <SimpleTabs>
                        <Tab Name="Dashboard" Icon="@MythetechFrameworkIcons.Dashboard">
                            <MudText>Dashboard content</MudText>
                        </Tab>
                        <Tab Name="Analytics" Icon="@MythetechFrameworkIcons.Round("analytics")">
                            <MudText>Analytics content</MudText>
                        </Tab>
                        <Tab Name="Reports" Icon="@MythetechFrameworkIcons.Round("assessment")">
                            <MudText>Reports content</MudText>
                        </Tab>
                        <Tab Name="Settings" Icon="@MythetechFrameworkIcons.Settings">
                            <MudText>Settings content</MudText>
                        </Tab>
                        <Tab Name="Users" Icon="@MythetechFrameworkIcons.Round("group")">
                            <MudText>Users content</MudText>
                        </Tab>
                    </SimpleTabs>
                </div>
            </MudStack>
        </Template>
    </Story>
</Stories>

@code {
    private double _containerWidthPercent = 100;
}