@using Mythetech.Framework.Components.AppContextDrawer
@using MudBlazor

@* An app that leaves the open state and active panel to the drawer, so nothing outside it re-renders the drawer *@
<MudPopoverProvider />
<AppContextDrawer ShowPluginPanels="false" EnableResizer="false">
    <PanelNavContent>
        @foreach (var id in Ids)
        {
            <ContextPanelItem @key="id" Id="@id" Icon="extension" Title="@($"Panel {id}")">
                <PanelContent>
                    <p>body of @id</p>
                </PanelContent>
            </ContextPanelItem>
        }
    </PanelNavContent>
</AppContextDrawer>

@code {
    [Parameter]
    public IReadOnlyList<string> Ids { get; set; } = ["a", "b"];
}
