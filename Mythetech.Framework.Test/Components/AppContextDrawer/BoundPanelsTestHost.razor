@using Mythetech.Framework.Components.AppContextDrawer
@using MudBlazor

@* An app that binds the drawer two-way and renders some items from a list with no @key, as Aion and Cerberus do *@
<MudPopoverProvider />
<AppContextDrawer @bind-IsOpen="IsOpen" @bind-ActivePanelId="ActivePanelId"
                  ShowPluginPanels="false" EnableResizer="false">
    <PanelNavContent>
        @foreach (var id in Ids)
        {
            <ContextPanelItem Id="@id" Icon="extension" Title="@($"Panel {id}")">
                <PanelContent>
                    <p>body of @id</p>
                </PanelContent>
            </ContextPanelItem>
        }
        <ContextPanelItem Id="history" Icon="extension" Title="History">
            <PanelContent>
                <p>history body</p>
            </PanelContent>
        </ContextPanelItem>
    </PanelNavContent>
</AppContextDrawer>

@code {
    [Parameter]
    public IReadOnlyList<string> Ids { get; set; } = ["a", "b", "c"];

    public bool IsOpen { get; private set; }

    public string? ActivePanelId { get; private set; }

    /// <summary>
    /// The app closing the drawer itself, as a layout's own collapse button does. The active panel's id stays.
    /// </summary>
    public void Collapse()
    {
        IsOpen = false;
        StateHasChanged();
    }
}
