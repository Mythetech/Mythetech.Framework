<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Prevent static asset conflicts with consuming app -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <PackageId>Mythetech.Framework.Desktop</PackageId>
        <VersionPrefix>0.19.1</VersionPrefix>
        <Authors>Mythetech</Authors>
        <Description>Desktop-specific components for cross platform Blazor applications using Hermes</Description>
        <PackageTags>blazor;desktop;hermes;components;ui;framework;cross-platform</PackageTags>
        <Copyright>Copyright (c) 2026 Mythetech</Copyright>
        <PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/mythetech/Mythetech.Framework</RepositoryUrl>
        <PackageProjectUrl>https://github.com/mythetech/Mythetech.Framework</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="LiteDB" Version="5.0.21" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
      <!-- Photino.Blazor used to bring this transitively, and every desktop host calls AddConsole().
           Kept explicit so dropping Photino stays a patch release; hosts can take it on directly later. -->
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
      <PackageReference Include="Mythetech.Hermes" Version="1.3.0" />
      <PackageReference Include="Mythetech.Hermes.Blazor" Version="1.3.0" />
      <PackageReference Include="TextCopy" Version="6.2.1" />
      <PackageReference Include="Velopack" Version="0.0.1298" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Mythetech.Framework\Mythetech.Framework.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\README.md" Pack="true" PackagePath="\" />
      <None Include="..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
