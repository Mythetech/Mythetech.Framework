@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Mythetech.Framework.Infrastructure.Plugins
@using Mythetech.Framework.Infrastructure.Plugins.Components

@foreach (var item in _menu?.Items ?? [])
{
    <MudMenuItem Class="@(_menu?.ItemClass ?? ItemClass)"
                 Icon="@item.Icon"
                 OnClick="@(() => HandleItemClick(item))"
                 Disabled="@item.Disabled">
        @item.Text
    </MudMenuItem>
}

@* Hidden render of the actual PluginMenu component to get proper Blazor lifecycle *@
@if (_owner is not null)
{
    <PluginGuard PluginInfo="@_owner" Metadata="@_metadata">
        <div style="display: none;">
            <DynamicComponent Type="@MenuType" @ref="_dynamicComponent"/>
        </div>
    </PluginGuard>
}

@code {
    [Parameter, EditorRequired] public Type MenuType { get; set; } = default!;

    [Parameter] public string ItemClass { get; set; } = "rounded";
    
    [Parameter, EditorRequired] public PluginContext PluginContext { get; set; } = default!;

    [Inject] private PluginState PluginState { get; set; } = default!;

    [Inject] private PluginMenuItemInvoker Invoker { get; set; } = default!;

    private DynamicComponent? _dynamicComponent;
    private PluginInfo? _owner;
    private PluginComponentMetadata _metadata = default!;
    private PluginMenu? _menu;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        _owner = PluginState.GetPluginForComponent(MenuType);
        _metadata = _owner?.MenuComponentsMetadata.FirstOrDefault(m => m.ComponentType == MenuType)
                    ?? new PluginComponentMetadata { ComponentType = MenuType, Title = MenuType.Name, Icon = MythetechFrameworkIcons.Extension };
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!_initialized && _dynamicComponent?.Instance is PluginMenu menu)
        {
            _menu = menu;
            _initialized = true;
            StateHasChanged();
        }
    }

    private async Task HandleItemClick(PluginMenuItem item)
    {
        await Invoker.InvokeAsync(item.OnClick, PluginContext, _owner?.Manifest.Name);

        if (_dynamicComponent?.Instance is PluginMenu menu)
        {
            _menu = menu;
            StateHasChanged();
        }
    }
}

