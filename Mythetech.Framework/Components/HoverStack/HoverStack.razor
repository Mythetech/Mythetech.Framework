@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inherits MudComponentBase
<div class="@RowClass" style="@Style" @onclick="HandleClick">
    <MudStack Class="hover-stack-content" Row="@Row" Reverse="@Reverse" Spacing="@Spacing" Wrap="@Wrap"
        Justify="@Justify" AlignItems="@AlignItems" StretchItems="@StretchItems">
        @ChildContent
    </MudStack>
    @if (Actions is not null)
    {
        <div class="mt-hover-actions">
            @Actions
        </div>
    }
</div>
@code {
    /// <summary>
    /// The row's content. Put <c>text-truncate</c> on its main label so the label gives up room to the actions
    /// instead of the row wrapping taller.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls shown at the end of the row while it is hovered or holds keyboard focus, and always on touch devices.
    /// They take their room from the content, so the row never grows. Never put a menu activator here: opening the
    /// menu ends the hover and hides the menu's own anchor.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// If true, displays items horizontally in a row instead of vertically.
    /// </summary>
    [Parameter]
    public bool Row { get; set; }

    /// <summary>
    /// If true, reverses the order of items along the main axis.
    /// </summary>
    [Parameter]
    public bool Reverse { get; set; }

    /// <summary>
    /// The spacing between items (0-16).
    /// </summary>
    [Parameter]
    public int Spacing { get; set; } = 3;

    /// <summary>
    /// Controls how items wrap when they exceed the container width. Defaults to no wrapping, so the row stays one
    /// line tall and its content truncates instead.
    /// </summary>
    [Parameter]
    public Wrap Wrap { get; set; } = Wrap.NoWrap;

    /// <summary>
    /// Defines how space is distributed along the main axis.
    /// </summary>
    [Parameter]
    public Justify Justify { get; set; } = Justify.FlexStart;

    /// <summary>
    /// Controls item alignment on the cross axis.
    /// </summary>
    [Parameter]
    public AlignItems AlignItems { get; set; } = AlignItems.Stretch;

    /// <summary>
    /// Specifies which children should expand to fill available space.
    /// </summary>
    [Parameter]
    public StretchItems StretchItems { get; set; } = StretchItems.None;

    /// <summary>
    /// Event callback invoked when the stack is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string RowClass => string.IsNullOrWhiteSpace(Class) ? "mt-hover-row mud-width-full" : $"mt-hover-row mud-width-full {Class}";

    private async Task HandleClick(MouseEventArgs args)
    {
        await OnClick.InvokeAsync(args);
    }
}
