@using MudBlazor
@using Mythetech.Framework
@using Microsoft.JSInterop
@using Mythetech.Framework.Infrastructure.Plugins
@using Mythetech.Framework.Infrastructure.MessageBus
@using Mythetech.Framework.Components.AppContextDrawer.Commands
@using Mythetech.Framework.Utilities
@implements IAsyncDisposable
@implements IConsumer<ActivatePanel>

<CascadingValue Name="ActivePanelId" Value="@ActivePanelId">
<CascadingValue Name="OnPanelItemClicked" Value="@_onPanelItemClicked">
<CascadingValue Name="OnPanelItemDoubleClicked" Value="@_onPanelItemDoubleClicked">
<CascadingValue Name="RegisterPanelItem" Value="@RegisterPanelItem">
<MudStack Spacing="0" Row="true" Class="@GetRootClass()" Style="@Style">
    @* Icon Bar *@
    <MudStack Spacing="1" Class="app-context-icon-bar" AlignItems="AlignItems.Center">
        @* Header slot (logo, create button, etc.) *@
        @if (IconBarHeader != null)
        {
            @IconBarHeader
        }

        @* App panels from PanelNavContent *@
        @PanelNavContent

        @* Plugin panels with separator *@
        @if (ShowPluginPanels && PluginState != null && PluginState.EnabledContextPanelComponentsMetadata.Any())
        {
            <MudDivider DividerType="DividerType.Middle" Class="my-2" Style="width:75%" />

            @foreach (var panelMeta in PluginState.EnabledContextPanelComponentsMetadata.OrderBy(p => p.Order))
            {
                var pluginPanelId = $"plugin-{panelMeta.ComponentType.FullName}";
                <ContextPanelItem @key="pluginPanelId"
                                  Id="@pluginPanelId"
                                  Icon="@panelMeta.Icon"
                                  Title="@panelMeta.Title"
                                  Order="@panelMeta.Order">
                    <PanelContent>
                        <DynamicComponent Type="@panelMeta.ComponentType" />
                    </PanelContent>
                </ContextPanelItem>
            }
        }

        <MudSpacer />

        @* Footer slot (settings, theme toggle, etc.) *@
        @if (PanelFooterContent != null)
        {
            @PanelFooterContent
        }
    </MudStack>

    @* Content Panel *@
    <MudStack Class="@GetContentClass()" Style="@GetContentStyle()">
        <MudPaper Class="h-100 w-100 bg-drawer"
                  Style="max-width:calc(var(--mud-drawer-width-left) - var(--mud-drawer-width-mini-left));max-height:100dvh"
                  Square="true">
            <MudStack Spacing="@ContentSpacing" Class="@ContentStackClass">
                @if (_activeItem != null)
                {
                    <MudStack Row="true" Class="@HeaderRowClass" Spacing="@(HeaderSpacing ?? 0)" AlignItems="AlignItems.Center">
                        <MudIcon Class="@HeaderIconClass" Icon="@_activeItem.Icon" Color="Color.Primary" />
                        <MudText Class="text-truncate" Typo="Typo.h6">@_activeItem.Title</MudText>
                        <MudSpacer />
                        <MudTooltip Text="Close" Color="Color.Primary">
                            <MudIconButton Icon="@CloseIcon"
                                           Variant="Variant.Text"
                                           OnClick="ClosePanel" />
                        </MudTooltip>
                    </MudStack>
                    @_activeItem.PanelContent
                }
                else if (EmptyContent != null)
                {
                    @EmptyContent
                }
                else
                {
                    <MudStack Row="true" Class="w-100">
                        <MudText Typo="Typo.subtitle1">No Item Selected</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@CloseIcon"
                                       Variant="Variant.Text"
                                       OnClick="ClosePanel" />
                    </MudStack>
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Select an item from the side menu</MudText>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudStack>

@* Resizer - rendered as sibling inside MudDrawer for proper positioning *@
@if (EnableResizer)
{
    <div class="@GetResizerClass()"></div>
}
</CascadingValue>
</CascadingValue>
</CascadingValue>
</CascadingValue>

@code {
    /// <summary>
    /// Content for the top of the icon bar (logo, create button, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? IconBarHeader { get; set; }

    /// <summary>
    /// Content for the main navigation panels (app-specific panels).
    /// Expects ContextPanelItem components.
    /// </summary>
    [Parameter]
    public RenderFragment? PanelNavContent { get; set; }

    /// <summary>
    /// Footer content (settings, theme toggle, profile button, etc.)
    /// </summary>
    [Parameter]
    public RenderFragment? PanelFooterContent { get; set; }

    /// <summary>
    /// Whether the drawer content is expanded (showing panel content).
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Callback when drawer open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>
    /// The ID of the currently active panel.
    /// </summary>
    [Parameter]
    public string? ActivePanelId { get; set; }

    /// <summary>
    /// Callback when active panel changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ActivePanelIdChanged { get; set; }

    /// <summary>
    /// Whether to show plugin panels. Default true.
    /// </summary>
    [Parameter]
    public bool ShowPluginPanels { get; set; } = true;

    /// <summary>
    /// Icon used by the button that closes the content panel.
    /// </summary>
    [Parameter]
    public string CloseIcon { get; set; } = MythetechFrameworkIcons.Close;

    /// <summary>
    /// Class on the stack that holds the panel header and the panel content.
    /// </summary>
    /// <remarks>
    /// Defaults to <c>pa-4</c>. Pass an empty string for panels that pad themselves.
    /// </remarks>
    [Parameter]
    public string? ContentClass { get; set; } = "pa-4";

    /// <summary>
    /// Spacing between the panel header and the panel content.
    /// </summary>
    /// <remarks>
    /// Defaults to <c>3</c>.
    /// </remarks>
    [Parameter]
    public int ContentSpacing { get; set; } = 3;

    /// <summary>
    /// Extra class on the panel header row.
    /// </summary>
    /// <remarks>
    /// Defaults to <c>null</c>.
    /// </remarks>
    [Parameter]
    public string? HeaderClass { get; set; }

    /// <summary>
    /// Spacing between the icon, title and close button of the panel header.
    /// </summary>
    /// <remarks>
    /// Defaults to <c>null</c>, which keeps a fixed margin after the icon and no other gaps.
    /// </remarks>
    [Parameter]
    public int? HeaderSpacing { get; set; }

    /// <summary>
    /// Shown when the drawer is open and no panel is active.
    /// </summary>
    /// <remarks>
    /// Defaults to <c>null</c>, which shows the built-in "No Item Selected" message.
    /// </remarks>
    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    /// <summary>
    /// Whether the resizer is enabled. Default true.
    /// </summary>
    [Parameter]
    public bool EnableResizer { get; set; } = true;

    /// <summary>
    /// Minimum drawer width when resizing (pixels). Default 200.
    /// </summary>
    [Parameter]
    public int MinWidth { get; set; } = 200;

    /// <summary>
    /// Maximum drawer width when resizing (pixels). Default 600.
    /// </summary>
    [Parameter]
    public int MaxWidth { get; set; } = 600;

    /// <summary>
    /// CSS class applied to the drawer root.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional CSS style applied to the drawer root.
    /// </summary>
    [Parameter]
    public string? Style { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private NavigationManager Nav { get; set; } = default!;

    [Inject]
    private PluginState? PluginState { get; set; }

    [Inject]
    private IMessageBus? MessageBus { get; set; }

    private IJSObjectReference? _jsModule;
    private ContextPanelItem? _activeItem;
    private bool _activeItemNeedsRender;
    private string? _removedPanelId;
    private bool _disposed;
    private readonly List<ContextPanelItem> _panels = new();
    private EventCallback<ContextPanelItem> _onPanelItemClicked;
    private EventCallback<ContextPanelItem> _onPanelItemDoubleClicked;

    private string ContentStackClass => Css.Merge(ContentClass, "w-100 h-100");

    private string HeaderRowClass => Css.Merge("w-100", HeaderClass);

    // Without a spacing the header keeps the layout it has always had: a margin after the icon and no gaps
    private string? HeaderIconClass => HeaderSpacing is null ? "mr-2" : null;

    protected override void OnInitialized()
    {
        _onPanelItemClicked = EventCallback.Factory.Create<ContextPanelItem>(this, HandlePanelItemClicked);
        _onPanelItemDoubleClicked = EventCallback.Factory.Create<ContextPanelItem>(this, HandlePanelItemDoubleClicked);

        if (PluginState != null)
        {
            PluginState.StateChanged += OnPluginStateChanged;
        }

        MessageBus?.Subscribe(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && EnableResizer)
        {
            await InitializeResizer();
        }

        if (_activeItemNeedsRender)
        {
            _activeItemNeedsRender = false;
            StateHasChanged();
        }

        if (_removedPanelId is { } removedPanelId)
        {
            _removedPanelId = null;

            // The app may have moved the highlight to another panel in the meantime
            if (ActivePanelId == removedPanelId)
            {
                await SetActivePanelId(null);
            }
        }
    }

    private async Task InitializeResizer()
    {
        try
        {
            _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Mythetech.Framework/mythetech.js");

            await _jsModule.InvokeVoidAsync(
                "initializeDrawerResizer",
                ".app-context-resizer",
                ".mud-drawer",
                MinWidth,
                MaxWidth);
        }
        catch
        {
            // JS interop may fail during prerendering
        }
    }

    /// <summary>
    /// Finds the panel that has this id now. The id an item registered with is no guide: a loop
    /// without @key hands the item's component to another item when the list changes.
    /// </summary>
    private ContextPanelItem? FindPanel(string id)
    {
        // Ids are meant to be unique. If two items share one, the later one wins.
        return _panels.FindLast(p => p.Id == id);
    }

    private void RegisterPanelItem(ContextPanelItem item)
    {
        _panels.Add(item);
        item.Disposed += HandlePanelItemDisposed;

        // A panel named by ActivePanelId before any click can only be matched once it has
        // registered, which happens while this component is already rendering its children.
        if (_activeItem == null && item.Id == ActivePanelId)
        {
            _activeItem = item;
            _activeItemNeedsRender = true;
        }
    }

    /// <summary>
    /// An item that leaves the page takes its panel with it, and the drawer falls back to its empty
    /// state. If another item has the id now, which is what a loop without @key leaves behind when
    /// it reuses components, that item's panel is shown instead.
    /// </summary>
    private void HandlePanelItemDisposed(ContextPanelItem item)
    {
        item.Disposed -= HandlePanelItemDisposed;
        _panels.Remove(item);

        if (_disposed || _activeItem != item)
        {
            return;
        }

        _activeItem = FindPanel(item.Id);

        if (_activeItem == null)
        {
            _removedPanelId = item.Id;
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task HandlePanelItemClicked(ContextPanelItem item)
    {
        if (!IsOpen)
        {
            // Open the drawer and set this as active
            _activeItem = item;
            await SetIsOpen(true);
            await SetActivePanelId(item.Id);
        }
        else if (_activeItem?.Id == item.Id)
        {
            // Clicking same item closes the drawer
            _activeItem = null;
            await SetIsOpen(false);
            await SetActivePanelId(null);
        }
        else
        {
            // Switch to different panel
            _activeItem = item;
            await SetActivePanelId(item.Id);
        }

        StateHasChanged();
    }

    /// <summary>
    /// A double click on a routed panel navigates to its page and collapses the drawer.
    /// The browser fires both single clicks before this, so the panel state is whatever
    /// those left behind; forcing it closed here makes the outcome deterministic.
    /// Double clicking the panel you are already on stays a plain double toggle.
    /// </summary>
    private async Task HandlePanelItemDoubleClicked(ContextPanelItem item)
    {
        if (string.IsNullOrWhiteSpace(item.RoutePrefix) || item.IsOnExactRoute)
        {
            return;
        }

        _activeItem = null;
        await SetIsOpen(false);
        await SetActivePanelId(null);
        StateHasChanged();

        Nav.NavigateTo($"/{item.RoutePrefix.TrimStart('/')}");
    }

    private async Task ClosePanel()
    {
        _activeItem = null;
        await SetIsOpen(false);
        await SetActivePanelId(null);
        StateHasChanged();
    }

    private async Task SetIsOpen(bool value)
    {
        if (IsOpen != value)
        {
            IsOpen = value;
            await IsOpenChanged.InvokeAsync(value);
        }
    }

    private async Task SetActivePanelId(string? value)
    {
        if (ActivePanelId != value)
        {
            ActivePanelId = value;
            await ActivePanelIdChanged.InvokeAsync(value);
        }
    }

    private void OnPluginStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public async Task Consume(ActivatePanel message)
    {
        if (FindPanel(message.PanelId) is { IsActive: false } panel)
        {
            await HandlePanelItemClicked(panel);
        }
    }

    private string GetRootClass()
    {
        var classes = new List<string> { "app-context-drawer", "mud-width-full", "mud-height-full" };
        if (!string.IsNullOrWhiteSpace(Class))
        {
            classes.Add(Class);
        }
        return string.Join(" ", classes);
    }

    private string GetContentClass()
    {
        return IsOpen ? "app-context-content" : "app-context-content app-context-content-hidden";
    }

    private string GetContentStyle()
    {
        return IsOpen ? "" : "width:0px;";
    }

    private string GetResizerClass()
    {
        return IsOpen ? "app-context-resizer" : "app-context-resizer app-context-resizer-hidden";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        foreach (var panel in _panels)
        {
            panel.Disposed -= HandlePanelItemDisposed;
        }

        _panels.Clear();

        if (PluginState != null)
        {
            PluginState.StateChanged -= OnPluginStateChanged;
        }

        MessageBus?.Unsubscribe(this);

        if (_jsModule != null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("teardownDrawerResizer");
                await _jsModule.DisposeAsync();
            }
            catch
            {
                // The host may already have torn the JS context down, which makes
                // the teardown call moot rather than a failure worth surfacing.
            }
            finally
            {
                _jsModule = null;
            }
        }
    }
}
