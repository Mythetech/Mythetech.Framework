@namespace Mythetech.Framework.Components.Kbd
@using System.Collections.Concurrent
@using MudBlazor
@using MudBlazor.Utilities
@using Mythetech.Framework.Infrastructure.Keyboard
@using Mythetech.Framework.Infrastructure.MessageBus
@using Mythetech.Framework.Infrastructure.Settings.Events
@inherits ComponentConsumer<SettingsModelChanged>
@inject IKeyBindingService Bindings
@inject IPlatformDetector PlatformDetector

@foreach (var action in Bindings.GetAll())
{
    if (action.CurrentBinding is not { } binding)
    {
        continue;
    }

    foreach (var variant in ModifierVariantsFor(binding))
    {
        <MudHotkey @key="@(action.Id + ":" + variant.Key)"
                   Key="binding.Key"
                   KeyModifiers="variant.Value"
                   OnHotkeyPressed="@(() => Bindings.InvokeAsync(action.Id, CancellationToken.None))" />
    }
}

@code {
    // MudHotkey registers again over JS interop whenever KeyModifiers changes by reference, so each set is built once.
    private static readonly ConcurrentDictionary<(JsKeyModifier? Accelerator, bool Shift, bool Alt), JsKeyModifier[]> ModifierSets = new();

    /// <summary>
    /// Re-renders when the shortcut settings change so newly assigned bindings
    /// register without a restart. This covers settings loaded asynchronously
    /// after the first render.
    /// </summary>
    protected override Task Consume(SettingsModelChanged message, CancellationToken cancellationToken)
    {
        if (message.Settings is KeyBindingSettings)
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Returns one modifier set per hotkey to register for this binding, keyed by
    /// the accelerator name used in the render key.
    ///
    /// On macOS an accelerator binding yields two sets, one for Cmd and one for
    /// Ctrl, so the shortcut fires whichever the user actually presses. The
    /// accelerator is a single concept in the model, and a user who records
    /// Ctrl+B on a Mac would otherwise get a binding that only Cmd+B triggers.
    /// Windows and Linux register Ctrl alone, so the Windows key never triggers
    /// a shortcut.
    /// </summary>
    private IReadOnlyList<KeyValuePair<string, IEnumerable<JsKeyModifier>>> ModifierVariantsFor(KeyBinding binding)
    {
        if (!binding.Ctrl)
        {
            return [new("none", Modifiers(binding, accelerator: null))];
        }

        if (!PlatformDetector.IsMacOS)
        {
            return [new("ctrl", Modifiers(binding, JsKeyModifier.ControlLeft))];
        }

        return
        [
            new("meta", Modifiers(binding, JsKeyModifier.MetaLeft)),
            new("ctrl", Modifiers(binding, JsKeyModifier.ControlLeft)),
        ];
    }

    private static IEnumerable<JsKeyModifier> Modifiers(KeyBinding binding, JsKeyModifier? accelerator)
        => ModifierSets.GetOrAdd((accelerator, binding.Shift, binding.Alt), static set =>
        {
            var modifiers = new List<JsKeyModifier>(3);

            if (set.Accelerator is { } key)
            {
                modifiers.Add(key);
            }

            if (set.Shift)
            {
                modifiers.Add(JsKeyModifier.ShiftLeft);
            }

            if (set.Alt)
            {
                modifiers.Add(JsKeyModifier.AltLeft);
            }

            return modifiers.ToArray();
        });
}
