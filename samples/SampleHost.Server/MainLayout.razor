@using MudBlazor
@using Mythetech.Framework
@using SampleHost.Shared
@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-3">Sample Host (Server)</MudText>
        <MudSpacer />
    </MudAppBar>

    <SampleAppDrawer @bind-Open="_drawerOpen" Title="Sample Host (Server)">
        <NavContent>
            <MudNavLink Href="/" Icon="@MythetechFrameworkIcons.Home">Home</MudNavLink>
            <MudNavLink Href="/copy" Icon="@MythetechFrameworkIcons.ContentCopy">Copy</MudNavLink>
        </NavContent>
    </SampleAppDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
}
